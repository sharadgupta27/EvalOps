# Copy to .env and fill in. Never commit .env. Every variable maps to backend/app/config.py.

# --- core ---
ENVIRONMENT=dev                 # dev | test | prod (prod refuses weak secrets)
DATABASE_URL=sqlite+aiosqlite:///./evalops.db   # Postgres: postgresql+psycopg://user:pass@host:5432/db
JWT_SECRET=                     # prod: 32+ random chars, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_EXPIRE_MINUTES=720
BCRYPT_ROUNDS=12
CORS_ORIGINS=["http://localhost:5173"]

# --- LLM ---
LLM_PROVIDER=fake               # fake (free, deterministic) | anthropic
ANTHROPIC_API_KEY=              # only when LLM_PROVIDER=anthropic
DEFAULT_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5
JUDGE_EFFORT=low

# --- guardrails ---
MAX_CASES_PER_RUN=200
MAX_COST_PER_RUN_USD=2.0
MAX_DAILY_COST_USD=20.0
MAX_UPLOAD_BYTES=2097152
RATE_LIMIT_PER_MINUTE=120
WORKER_CONCURRENCY=4

# --- demo seed ---
DEMO_PASSWORD=evalops-demo-2026

# --- observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=    # e.g. http://otel-collector:4318
LOG_LEVEL=INFO

# --- production compose only (docker-compose.prod.yml) ---
DOMAIN=evalops.example.com
POSTGRES_PASSWORD=
IMAGE_OWNER=your-github-user
