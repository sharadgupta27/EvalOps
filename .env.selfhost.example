# Self-hosted EvalOps (docker-compose.selfhost.yml). Copy to .env.selfhost and fill in. Never commit it.
POSTGRES_PASSWORD=                  # openssl rand -hex 24
JWT_SECRET=                         # 32+ random characters: python -c "import secrets;print(secrets.token_urlsafe(48))"

# Where users open EvalOps. Set it to the tunnel URL if you publish one (it feeds CORS).
PUBLIC_URL=http://localhost:5173
BIND_ADDRESS=127.0.0.1              # keep it: the tunnel container reaches the frontend over the Docker network
HTTP_PORT=5173
API_PORT=8000

# fake = free, deterministic, sends nothing anywhere | anthropic = real judge and model calls (data goes to Anthropic)
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
MAX_COST_PER_RUN_USD=0.50
MAX_DAILY_COST_USD=5.0

# Only with `--profile funnel` (Tailscale Funnel)
TS_AUTHKEY=
TS_HOSTNAME=evalops
# Only with `--profile tunnel` (Cloudflare Tunnel)
TUNNEL_TOKEN=
